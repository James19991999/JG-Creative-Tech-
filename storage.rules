rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Client Portal documents. Each client's files live under
    // clients/{their own uid}/documents/... - a user can only read or
    // write inside their own path, verified against the Storage
    // auth token, not anything the client claims in the request.
    match /clients/{uid}/documents/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 20 * 1024 * 1024; // 20MB cap, matches lib/client-portal/actions.ts
      allow delete: if false; // deletions are an admin-only operation via the Admin SDK
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
