# Firebase Admin SDK credentials, used server-side only by the
# /api/contact and /api/newsletter route handlers to write submissions
# to Firestore. Generate these from:
# Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
#
# Without these set, the API routes still work end-to-end - they just
# log submissions to the server console instead of writing to Firestore,
# which is convenient for local development.

FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Keep the surrounding quotes and \n escapes exactly as exported by Firebase.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Client Portal (/client-portal) - Firebase client SDK config, used
# for sign-in, Firestore reads, and Storage upload/download. These are
# public by design (safe to ship to the browser); real protection comes
# from firestore.rules and storage.rules, not from keeping these secret.
# Generate from: Firebase Console -> Project Settings -> General ->
# Your apps -> Web app -> SDK setup and configuration.
#
# Without these set, the portal shows a clear "not configured" message
# instead of crashing.
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
