# Firebase Admin SDK credentials, used server-side only by the
# /api/contact and /api/newsletter route handlers to write submissions
# to Firestore. Generate these from:
# Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
#
# Without these set, the API routes still work end-to-end - they just
# log submissions to the server console instead of writing to Firestore,
# which is convenient for local development.

FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Keep the surrounding quotes and \n escapes exactly as exported by Firebase.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Client Portal (/client-portal) - Firebase client SDK config, used
# for sign-in, Firestore reads, and Storage upload/download. These are
# public by design (safe to ship to the browser); real protection comes
# from firestore.rules and storage.rules, not from keeping these secret.
# Generate from: Firebase Console -> Project Settings -> General ->
# Your apps -> Web app -> SDK setup and configuration.
#
# Without these set, the portal shows a clear "not configured" message
# instead of crashing.
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# Client Portal invoice payments (card + M-Pesa via IntaSend). Get
# your keys from: Sandbox - https://sandbox.intasend.com/account/api-keys/
# Live - https://payment.intasend.com/account/api-keys/
# Sandbox keys contain "test" in them (e.g. ISSecretKey_test_...) -
# this project detects sandbox vs. live automatically from that, so
# there's no separate "test mode" flag to keep in sync.
#
# INTASEND_WEBHOOK_CHALLENGE is a secret string YOU choose and enter
# into the IntaSend dashboard (Settings -> Webhooks) when registering
# your webhook URL (https://your-domain.com/api/webhooks/intasend).
# IntaSend echoes it back on every webhook call so this server can
# confirm the request is really from IntaSend - see the security note
# at the top of app/api/webhooks/intasend/route.ts for exactly what
# this does and does not guarantee.
#
# Without these set, "Pay Now" shows a clear "payments aren't
# configured yet" error instead of crashing.
INTASEND_PUBLISHABLE_KEY=ISPubKey_test_xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
INTASEND_SECRET_KEY=ISSecretKey_test_xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
INTASEND_WEBHOOK_CHALLENGE=choose-a-long-random-string

# Email notifications (contact form, consultation bookings, newsletter
# signups) via Resend - https://resend.com. Get RESEND_API_KEY from
# https://resend.com/api-keys after signing up (free tier is generous
# enough for a small business's form volume).
#
# RESEND_FROM_EMAIL must be an address on a domain you've verified in
# Resend's dashboard (Domains -> Add Domain, then add the DNS records
# it gives you). Until you verify your own domain, Resend lets you
# send FROM their shared onboarding@resend.dev address for testing,
# but real production email should come from your own domain (e.g.
# notifications@jgcreativetechsolution.org) so it doesn't look like
# spam and so replies work properly.
#
# Without these set, forms still work exactly as before (submissions
# are still saved to Firestore) - they just silently skip sending any
# email, logging that to the server console instead of erroring.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=JG Creative Tech <notifications@jgcreativetechsolution.org>

# Google Analytics 4 - real traffic data, gated behind the site's
# existing cookie consent (Consent Mode v2, see components/
# Analytics.tsx for exactly how). Get your Measurement ID from
# https://analytics.google.com -> Admin -> Data Streams -> your web
# stream. Looks like "G-XXXXXXXXXX".
#
# This is NEXT_PUBLIC_ (not secret) because gtag.js runs entirely in
# the visitor's browser - the measurement ID is necessarily visible in
# page source either way, the same as it would be with any analytics
# tool.
#
# Without this set, no analytics scripts load at all - not even a
# consent-denied stub - matching how every other optional integration
# in this project degrades when unconfigured.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
