# Firebase Admin SDK credentials, used server-side only by the
# /api/contact and /api/newsletter route handlers to write submissions
# to Firestore. Generate these from:
# Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
#
# Without these set, the API routes still work end-to-end - they just
# log submissions to the server console instead of writing to Firestore,
# which is convenient for local development.

FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Keep the surrounding quotes and \n escapes exactly as exported by Firebase.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
